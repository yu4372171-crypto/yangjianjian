# Public builds do not embed an account or password.
YJJ_ADMIN_USER=local-owner
# Use YJJ_ADMIN_PASSWORD_HASH in deployments. The plaintext form is for local
# development only and should not be committed to source control.
YJJ_ADMIN_PASSWORD_HASH=
YJJ_ADMIN_PASSWORD=

# Optional. Point this at a directory containing ffmpeg.exe and ffprobe.exe.
YJJ_FFMPEG_DIR=

# Optional runtime data and Python locations.
YJJ_DATA_DIR=
AIVE_PYTHON=
